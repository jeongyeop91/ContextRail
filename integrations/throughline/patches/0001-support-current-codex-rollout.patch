+test('captureCodexRolloutToDb: captures current Codex response messages and custom tools', () => {
+  const db = makeDb();
+  const home = mkdtempSync(join(tmpdir(), 'tl-codex-home-'));
+  const project = mkdtempSync(join(tmpdir(), 'tl-codex-project-'));
+  const threadId = '01a03b32-3b8b-72d0-a284-b466acd6d9a9';
+  try {
+    writeRollout(home, {
+      id: threadId,
+      cwd: project,
+      events: [
+        responseItem({
+          type: 'message',
+          role: 'user',
+          content: [{ type: 'input_text', text: '<recommended_plugins>host context</recommended_plugins>' }],
+        }),
+        responseItem({
+          type: 'message',
+          role: 'user',
+          content: [{ type: 'input_text', text: 'current request' }],
+        }),
+        event('task_started'),
+        responseItem({
+          type: 'message',
+          role: 'assistant',
+          content: [{ type: 'output_text', text: 'working update' }],
+        }),
+        responseItem({
+          type: 'custom_tool_call',
+          name: 'exec',
+          input: '{"cmd":"pwd"}',
+          call_id: 'call_current',
+        }),
+        responseItem({
+          type: 'custom_tool_call_output',
+          call_id: 'call_current',
+          output: [{ type: 'input_text', text: 'Command completed\n/tmp/project\n' }],
+        }),
+        responseItem({
+          type: 'message',
+          role: 'assistant',
+          content: [{ type: 'output_text', text: 'current answer' }],
+        }),
+        event('task_complete'),
+      ],
+    });
+
+    const result = captureCodexRolloutToDb(db, {
+      threadId,
+      codexHome: home,
+      projectPath: project,
+      now: 1234,
+    });
+
+    assert.equal(result.status, 'captured');
+    assert.equal(result.capturedTurns, 1);
+    assert.equal(result.capturedRows, 2);
+    assert.equal(result.capturedDetails, 2);
+
+    const bodies = db.prepare('SELECT turn_number, role, text FROM bodies ORDER BY id').all();
+    assert.deepEqual(
+      bodies.map((row) => [row.turn_number, row.role, row.text]),
+      [
+        [1, 'user', 'current request'],
+        [1, 'assistant', 'working update\n\ncurrent answer'],
+      ],
+    );
+
+    const details = db
+      .prepare(
+        'SELECT turn_number, kind, tool_name, source_id, input_text, output_text FROM details ORDER BY id',
+      )
+      .all();
+    assert.deepEqual(
+      details.map((row) => [
+        row.turn_number,
+        row.kind,
+        row.tool_name,
+        row.source_id,
+        row.input_text,
+        row.output_text,
+      ]),
+      [
+        [1, 'tool_input', 'exec', 'call_current', '{"cmd":"pwd"}', null],
+        [
+          1,
+          'tool_output',
+          'exec',
+          'call_current:output',
+          null,
+          '[{"type":"input_text","text":"Command completed\\n/tmp/project\\n"}]',
+        ],
+      ],
+    );
+  } finally {
+    rmSync(home, { recursive: true, force: true });
+    rmSync(project, { recursive: true, force: true });
+  }
+});
+
