index 0000000000000000000000000000000000000000..4f6d5e012c5822960d3ee54bde51430980a27438
--- /dev/null
+++ b/src/codex-cli-resolver.mjs
@@ -0,0 +1,83 @@
+import { existsSync, readdirSync } from 'node:fs';
+import { posix, win32 } from 'node:path';
+
+function defaultListDirectoryNames(path) {
+  try {
+    return readdirSync(path, { withFileTypes: true })
+      .filter((entry) => entry.isDirectory())
+      .map((entry) => entry.name)
+      .sort();
+  } catch {
+    return [];
+  }
+}
+
+function firstExisting(candidates, pathExists) {
+  return candidates.find((candidate) => {
+    try {
+      return pathExists(candidate);
+    } catch {
+      return false;
+    }
+  }) ?? null;
+}
+
+function findWindowsUserLocalCodex({ localAppData, pathExists, listDirectoryNames }) {
+  if (!localAppData) return null;
+  const roots = [
+    win32.join(localAppData, 'Programs', 'OpenAI', 'Codex', 'bin'),
+    win32.join(localAppData, 'OpenAI', 'Codex', 'bin'),
+    win32.join(
+      localAppData,
+      'Packages',
+      'OpenAI.Codex_2p2nqsd0c76g0',
+      'LocalCache',
+      'Local',
+      'OpenAI',
+      'Codex',
+      'bin',
+    ),
+  ];
+  const direct = firstExisting(roots.map((root) => win32.join(root, 'codex.exe')), pathExists);
+  if (direct) return direct;
+  for (const root of roots) {
+    const nested = firstExisting(
+      listDirectoryNames(root)
+        .slice()
+        .sort()
+        .reverse()
+        .map((name) => win32.join(root, name, 'codex.exe')),
+      pathExists,
+    );
+    if (nested) return nested;
+  }
+  return null;
+}
+
+export function resolveCodexAppServerCommand({
+  platform = process.platform,
+  env = process.env,
+  pathExists = existsSync,
+  listDirectoryNames = defaultListDirectoryNames,
+} = {}) {
+  const args = ['app-server', '--listen', 'stdio://'];
+  if (env.CODEX_CLI_PATH && firstExisting([env.CODEX_CLI_PATH], pathExists)) {
+    return { command: env.CODEX_CLI_PATH, commandArgs: args, source: 'codex_cli_path' };
+  }
+  if (platform === 'win32') {
+    const command = findWindowsUserLocalCodex({
+      localAppData: env.LOCALAPPDATA,
+      pathExists,
+      listDirectoryNames,
+    });
+    if (command) return { command, commandArgs: args, source: 'windows_desktop_user_cache' };
+  }
+  if (platform === 'darwin') {
+    const command = firstExisting([
+      posix.join('/Applications', 'Codex.app', 'Contents', 'Resources', 'codex'),
+      posix.join('/Applications', 'ChatGPT.app', 'Contents', 'Resources', 'codex'),
+    ], pathExists);
+    if (command) return { command, commandArgs: args, source: 'macos_desktop_bundle' };
+  }
+  return { command: 'codex', commandArgs: args, source: 'path' };
+}
