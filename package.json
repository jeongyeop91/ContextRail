{
  "name": "contextrail",
  "version": "0.3.0-rc.3",
  "description": "Repository-local context routing and continuity for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeongyeop91/ContextRail.git"
  },
  "homepage": "https://github.com/jeongyeop91/ContextRail#readme",
  "bugs": {
    "url": "https://github.com/jeongyeop91/ContextRail/issues"
  },
  "keywords": [
    "coding-agent",
    "context-management",
    "developer-tools",
    "repository-template"
  ],
  "files": [
    "bin/",
    "src/",
    "templates/",
    "integrations/setup-manifest.json",
    "integrations/throughline/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "contextrail": "bin/contextrail.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:release": "node scripts/build-release.mjs",
    "test": "node --test",
    "check": "node bin/contextrail.mjs check",
    "smoke:template": "node --test --test-name-pattern='repository template applies' test/scaffold.test.mjs",
    "verify": "npm test && npm run check && npm run smoke:template && git diff --check"
  }
}
